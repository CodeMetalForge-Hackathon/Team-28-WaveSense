# Copy to wifi-sensing/.env (git-ignored) and change what differs on your Pi.
# Every value here is a non-secret placeholder. The scripts parse this file as
# plain KEY=VALUE lines and never execute it. Exported environment variables
# override values in .env.
#
# Never put the API token or the Wi-Fi password in this file or in git.

# USB Wi-Fi adapter that runs the hotspot (Panda PAU0F showed up as wlan1).
CSI_IFACE=wlan1

# NetworkManager profile name of the hotspot.
HOTSPOT_CONN=ForgeCSI

# UDP port the ESP32 nodes were provisioned to send to (provision.py --target-port).
CSI_UDP_PORT=5005

# Docker container name and image. The digest is the one tested on 2026-11-07;
# a bare ":latest" tag may change under you.
RUVIEW_CONTAINER_NAME=ruview-live
RUVIEW_IMAGE=ruvnet/wifi-densepose@sha256:73dd3f626aef369ea4542d353d4aeb227c156d8b07d034b6a4fe697e96bd57bc
DOCKER_NETWORK=bridge

# RuView HTTP API. Loopback only: the token is sent over plain HTTP.
RUVIEW_URL=http://127.0.0.1:3000

# PATH to a file holding the API token (chmod 600). This is a path, not the token.
RUVIEW_API_TOKEN_FILE=~/.config/ruview/api_token

# Local copies outside the repo, used by diagnose.sh only.
FIRMWARE_BUNDLE_DIR=~/ruview-firmware-c5/c5-bundle
ESP_TOOLS_DIR=~/esp-tools
ESP_BACKUP_DIR=~/esp-backups
